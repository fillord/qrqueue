# Скопировать в .env и заполнить. .env в git не коммитить.

APP_DOMAIN=queue.example.com

# Postgres
POSTGRES_DB=queue
POSTGRES_USER=queue
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://queue:change-me@db:5432/queue

# Redis
REDIS_URL=redis://redis:6379/0

# Секреты — сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me
QR_TOKEN_SECRET=change-me

# Живой QR: срок жизни одного токена и на сколько минут вперёд
# сервер выдаёт пачку токенов ТВ-экрану (защита от просадок сети)
QR_TOKEN_TTL_SECONDS=45
QR_TOKEN_BATCH_MINUTES=15

# Сколько минут у посетителя на подтверждение «я здесь» после вызова
PRESENCE_TIMEOUT_MINUTES=3

# Суперадмин, создаётся при первом запуске
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# Web Push (VAPID), сгенерировать позже: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
